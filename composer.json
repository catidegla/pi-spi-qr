{
    "name": "catidegla/pi-spi-qr",
    "description": "Build, parse and validate PI-SPI interoperable QR payloads for the BCEAO instant payment platform, in PHP. No dependencies.",
    "keywords": [
        "pi-spi",
        "bceao",
        "uemoa",
        "qr-code",
        "emv",
        "payments",
        "xof",
        "instant-payment",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Christ-loisele Atidegla"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Catidegla\\PiSpiQr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Catidegla\\PiSpiQr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "illuminate/support": "Enables the Laravel bridge: a config-aware builder, a validation rule for scanned payloads, and an artisan command."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Catidegla\\PiSpiQr\\Laravel\\PiSpiServiceProvider"
            ],
            "aliases": {
                "PiSpi": "Catidegla\\PiSpiQr\\Laravel\\Facades\\PiSpi"
            }
        }
    }
}
